## Step 3 – Update the webhook (clearAbuseFlag + re-lock)
Replace the existing clearAbuseFlag function with this version:
JavaScript

async function clearAbuseFlag(supabase: any, userId: string) {
  const { data: profile } = await supabase
    .from('profiles')
    .select('account_status, flagged_cluster_id, abuse_lock_exempt')
    .eq('id', userId)
    .single()

  if (!profile || profile.account_status === 'active') return
  if (profile.abuse_lock_exempt) return   // admin override — leave alone

  await supabase
    .from('profiles')
    .update({ account_status: 'active' })
    .eq('id', userId)

  console.log(`Cleared abuse flag for user ${userId} after upgrade`)

  if (!profile.flagged_cluster_id) return

  const { data: remaining } = await supabase
    .from('profiles')
    .select('id')
    .eq('flagged_cluster_id', profile.flagged_cluster_id)
    .neq('account_status', 'active')

  if (!remaining || remaining.length === 0) {
    await supabase
      .from('flagged_ip_clusters')
      .update({ resolved_at: new Date().toISOString() })
      .eq('id', profile.flagged_cluster_id)

    console.log(`Cluster ${profile.flagged_cluster_id} fully resolved`)
  }
}

