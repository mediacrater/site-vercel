##  Step 4 – Bring back a controlled resolution sweep in abuseDetection.js
Add this function (it replaces the old one we deleted):
JavaScript

async function resolveClearedClusters() {
  const supabase = supabaseRef;
  try {
    // Only look at accounts the system is allowed to manage
    const { data: lockedAccounts, error } = await supabase
      .from('profiles')
      .select('id, ip_at_creation, flagged_cluster_id, plan, abuse_lock_exempt')
      .eq('account_status', 'action_required')
      .eq('abuse_lock_exempt', false)
      .not('ip_at_creation', 'is', null);

    if (error) {
      console.error('[ABUSE] Resolution sweep fetch failed:', summarizeError(error));
      return;
    }

    if (!lockedAccounts || lockedAccounts.length === 0) return;

    const byIp = new Map();
    for (const acc of lockedAccounts) {
      if (!byIp.has(acc.ip_at_creation)) byIp.set(acc.ip_at_creation, []);
      byIp.get(acc.ip_at_creation).push(acc);
    }

    for (const [ip, accountsAtIp] of byIp.entries()) {
      for (const acc of accountsAtIp) {
        // Case 1: account is no longer free → unlock
        if (acc.plan !== 'free') {
          const { error: unlockError } = await supabase
            .from('profiles')
            .update({ account_status: 'active' })
            .eq('id', acc.id);

          if (unlockError) {
            console.error('[ABUSE] Failed to auto-unlock paid account:', summarizeError(unlockError));
            continue;
          }
          console.error(`[ABUSE] Auto-unlocked paid user ${acc.id}`);
          continue;
        }

        // Case 2: still free — only unlock if no other free peer remains
        const { data: peers, error: peerError } = await supabase
          .from('profiles')
          .select('id')
          .eq('ip_at_creation', ip)
          .eq('plan', 'free')
          .neq('id', acc.id)
          .limit(1);

        if (peerError) {
          console.error('[ABUSE] Resolution peer check failed:', summarizeError(peerError));
          continue;
        }

        if (peers && peers.length > 0) continue; // still has a free peer → stay locked

        const { error: unlockError } = await supabase
          .from('profiles')
          .update({ account_status: 'active' })
          .eq('id', acc.id);

        if (unlockError) {
          console.error('[ABUSE] Failed to auto-unlock account:', summarizeError(unlockError));
          continue;
        }

        console.error(`[ABUSE] Auto-unlocked user ${acc.id} — no free peers remain at IP ${ip}`);

        if (acc.flagged_cluster_id) {
          await supabase
            .from('flagged_ip_clusters')
            .update({ resolved_at: new Date().toISOString() })
            .eq('id', acc.flagged_cluster_id)
            .is('resolved_at', null);
        }
      }
    }
  } catch (err) {
    console.error('[ABUSE] Resolution sweep crashed:', summarizeError(err));
  }
